# Copy to .env and fill in ONE provider key. LiteLLM picks the right one from the model prefix.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Any LiteLLM model string
LLM_MODEL=gemini/gemini-2.5-flash
JUDGE_MODEL=gemini/gemini-2.5-flash

# Retrieval knobs (change these, re-ingest, re-run the eval)
CHUNK_TOKENS=500
CHUNK_OVERLAP=75
TOP_K=5
CORPUS_VERSION=v1
